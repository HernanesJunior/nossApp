rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isCoupleMember() {
      return request.auth != null
        && request.auth.uid in [
          '0nToiexTS9VckpFYXSjnx5JCrfj2',
          'CIGPWAGPA1gEFvTu8QgcxQR3P2H2'
        ];
    }

    match /profiles/{userId}/{filePath=**} {
      allow read: if isCoupleMember();
      allow write: if isCoupleMember() && request.auth.uid == userId;
    }

    match /attachments/{filePath=**} {
      allow read, write: if isCoupleMember();
    }

    match /audio/{filePath=**} {
      allow read, write: if isCoupleMember();
    }
  }
}
